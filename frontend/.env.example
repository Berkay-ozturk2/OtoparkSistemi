# Bu dosyayı .env olarak kopyalayın (isteğe bağlı).

# Backend adresi. BOŞ bırakılırsa Vite proxy'si kullanılır (önerilen: /api ve /hubs → http://localhost:5080).
# Proxy olmadan doğrudan bağlanmak için örn.: VITE_API_URL=http://localhost:5080
VITE_API_URL=

# Görüntü işleme servisi. Varsayılan /vision (proxy → http://localhost:8000, önek silinir).
# Doğrudan bağlanmak için örn.: VITE_VISION_URL=http://localhost:8000
VITE_VISION_URL=/vision

# Proxy hedefleri (yalnızca vite.config.js okur; tarayıcıya gönderilmez)
PROXY_API_TARGET=http://localhost:5080
PROXY_VISION_TARGET=http://localhost:8000

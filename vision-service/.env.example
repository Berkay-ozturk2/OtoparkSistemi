# Bu dosyayı .env olarak kopyalayın:  copy .env.example .env   (Windows)
# Ortam değişkenleri .env dosyasındaki değerleri ezer.

# --- Backend ---
BACKEND_URL=http://localhost:5080
VISION_API_KEY=dev-vision-key
BACKEND_TIMEOUT=5
BACKEND_RETRIES=3

# --- Modeller (models/ klasörüne göre) ---
PLATE_MODEL=plate_detector_tr.pt
VEHICLE_MODEL=yolov8n.pt
CHAR_MODEL=char_reader.pt
CHAR_CLASSES=char_classes.txt
# true: .onnx dosyası varsa onu kullan (torch olmadan CPU'da çalışır)
PREFER_ONNX=false
# "" otomatik, "cpu" ya da "0" (ilk NVIDIA GPU)
DEVICE=
LOAD_VEHICLE_DETECTOR=true
ALLOW_MODEL_DOWNLOAD=true

# --- OCR: auto | yolo-char | easyocr | none ---
OCR_ENGINE=auto
# CUDA destekli torch kuruluysa GPU otomatik kullanılır (scripts\gpu_kur.bat)
OCR_GPU=false
OCR_VARIANTS=gray,clahe,adaptive,otsu
# Canlı kamerada kare başına kaç ön işleme denensin (1 = en hızlı)
LIVE_OCR_VARIANTS=1
# Bundan dar plakalarda (araç uzaktayken) OCR atlanır — piksel
MIN_OCR_PLATE_WIDTH=50

# --- Eşikler ---
CONFIDENCE=0.40
VEHICLE_CONFIDENCE=0.35
# COCO yolov8n: 2,3,5,7 (car, motorcycle, bus, truck). Kendi tek sınıflı araç modeliniz için: 0
VEHICLE_CLASSES=2,3,5,7
OCCUPANCY_THRESHOLD=0.35
OCCUPANCY_FOOTPRINT=1.0
OCCUPANCY_SMOOTHING=5
OCCUPANCY_FULL_REPORT_SECONDS=60

# --- Giriş/çıkış oylaması ---
VOTE_WINDOW_SECONDS=1.5
VOTE_MIN_READS=3
PLATE_COOLDOWN_SECONDS=30
INVALID_COOLDOWN_SECONDS=15
SEND_PLATE_CROP=true

# --- Diğer ---
CAMERAS_FILE=config/cameras.yaml
SLOTS_FILE=config/slots.json
HEARTBEAT_INTERVAL=10
AUTOSTART_AGENTS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
MAX_UPLOAD_MB=15
